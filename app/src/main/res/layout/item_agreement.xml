<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/calm_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_agreement_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weekend Curfew &amp; Screen Compromise"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/soft_text" />

        <TextView
            android:id="@+id/tv_agreement_compromise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compromise: 10:30 PM bedtime on Friday/Saturday if homework is completed."
            android:textSize="13sp"
            android:textColor="@color/teal_primary"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_agreement_cooldown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="48h Cooldown Active: Changes locked until cooling period ends."
            android:textSize="11sp"
            android:textColor="@color/soft_amber"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
