<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiered Trust &amp; Shared Log"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/soft_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trust is earned through agreed milestones, not silent judgment."
            android:textSize="14sp"
            android:textColor="@color/subtle_gray"
            android:layout_marginBottom="16dp" />

        <!-- Trust Tier Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/calm_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_trust_tier_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Freedom Tier: Level 2"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_primary" />

                <ProgressBar
                    android:id="@+id/pb_trust_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:progress="85"
                    android:max="100"
                    android:progressTint="@color/teal_primary"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tv_trust_milestone_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next Milestone: Level 3 (100 pts) unlocks custom app choices &amp; $10 auto purchase approval."
                    android:textSize="12sp"
                    android:textColor="@color/subtle_gray"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Add Promise Log Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/calm_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log a Promise (Parent &amp; Teen)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/soft_text" />

                <EditText
                    android:id="@+id/et_promise_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Promise Title (e.g. Homework finished before gaming)"
                    android:layout_marginTop="8dp" />

                <RadioGroup
                    android:id="@+id/rg_promise_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rb_kept"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kept Promise (+10 pts)"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rb_missed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Missed Promise (-5 pts)" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_add_trust_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save to Shared Trust Log"
                    android:backgroundTint="@color/teal_primary"
                    android:textColor="@color/calm_surface"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Shared Trust Log List -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shared Trust History"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/soft_text"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_trust_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
