<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Talk Before Block &amp; Requests"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/soft_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Direct communication prevents unfair restrictions and arguments."
            android:textSize="14sp"
            android:textColor="@color/subtle_gray"
            android:layout_marginBottom="16dp" />

        <!-- Request Blocked App Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/calm_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Request Access to Blocked App"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_primary" />

                <EditText
                    android:id="@+id/et_app_request_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="App Name (e.g. Educational Photo Editor)"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/et_app_request_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="State reason (e.g. Needed for Art class project)"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btn_submit_app_request"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Submit Request (24h Decision Window)"
                    android:backgroundTint="@color/teal_primary"
                    android:textColor="@color/calm_surface"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Active Check-Ins List -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending 'Talk Before Block' Check-Ins"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/soft_text"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_checkins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="16dp" />

        <!-- App Requests List -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Access Requests"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/soft_text"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_app_requests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
