<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/calm_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_item_rule_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bedtime Screen Limit"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/soft_text" />

            <TextView
                android:id="@+id/tv_item_rule_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AGREED"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/soft_green" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_item_rule_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category: Social Media • Limit: 120m daily • Proposed by Parent"
            android:textSize="13sp"
            android:textColor="@color/subtle_gray"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
