<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Familiar Family Overview"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/soft_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safety built on mutual trust, privacy, and shared decisions."
            android:textSize="14sp"
            android:textColor="@color/subtle_gray"
            android:layout_marginBottom="16dp" />

        <!-- Trust & Level Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/calm_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_trust_level_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trust Level 2: Growing Independence"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_primary" />

                <TextView
                    android:id="@+id/tv_trust_score_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trust Score: 85 pts • 8 Kept Promises"
                    android:textSize="14sp"
                    android:textColor="@color/soft_text"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_unlocked_freedom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Freedom: Social apps allowed, 9:00 PM Bedtime flexibility."
                    android:textSize="13sp"
                    android:textColor="@color/subtle_gray"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Emergency & Grace Quick Action -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/calm_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lockout Prevention &amp; Safety"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/soft_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="School apps, calls, maps, and emergency contacts are ALWAYS available."
                    android:textSize="13sp"
                    android:textColor="@color/subtle_gray"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btn_open_emergency"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Emergency Override"
                        android:backgroundTint="@color/soft_amber"
                        android:textColor="@color/calm_surface"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_request_grace_quick"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Request Grace 15m"
                        android:backgroundTint="@color/teal_primary"
                        android:textColor="@color/calm_surface" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Plain Language Activity Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plain-Language Activity Log"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/soft_text"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_activity_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
