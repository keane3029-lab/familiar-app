<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@color/calm_surface"
    android:layout_marginBottom="4dp">

    <TextView
        android:id="@+id/tv_log_time"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="09:00 PM"
        android:textSize="12sp"
        android:textColor="@color/subtle_gray" />

    <TextView
        android:id="@+id/tv_log_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Bedtime rule activated. Emergency allowlist apps remain active."
        android:textSize="13sp"
        android:textColor="@color/soft_text" />

</LinearLayout>
