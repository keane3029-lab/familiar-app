<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/calm_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_request_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Photo Editor Pro (Category: Creativity)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/soft_text" />

        <TextView
            android:id="@+id/tv_request_reason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reason: Needed for Art homework project."
            android:textSize="13sp"
            android:textColor="@color/subtle_gray"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_request_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usage Summary: 20 mins daily average • Decision window: 23h remaining"
            android:textSize="12sp"
            android:textColor="@color/teal_primary"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
