<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complete Transparency"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/soft_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teen sees exactly what the parent sees. Zero hidden monitoring."
            android:textSize="14sp"
            android:textColor="@color/subtle_gray"
            android:layout_marginBottom="16dp" />

        <!-- Privacy Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/calm_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Protection Guarantee"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/soft_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✔ Only aggregate category screen time totals are tracked.
✔ NEVER collects message contents or private chats.
✔ NEVER monitors web browsing history or search queries.
✔ Data stays 100% on your local device unless optional cloud sync is enabled."
                    android:textSize="13sp"
                    android:textColor="@color/soft_text"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btn_open_privacy_policy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Read Plain English Privacy Policy"
                    android:backgroundTint="@color/teal_primary"
                    android:textColor="@color/calm_surface"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Category Screen Time Totals -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shared View: Today's Usage Totals"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/soft_text"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_usage_totals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
