<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/warm_cream"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emergency Override &amp; Safety"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/soft_text"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Accidental phone lockouts are strictly prevented in Familiar."
        android:textSize="14sp"
        android:textColor="@color/subtle_gray"
        android:layout_marginTop="8dp"
        android:gravity="center" />

    <!-- Big Emergency Override Button -->
    <Button
        android:id="@+id/btn_trigger_emergency"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="1-TAP EMERGENCY OVERRIDE"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/soft_amber"
        android:textColor="@color/calm_surface"
        android:layout_marginTop="32dp" />

    <Button
        android:id="@+id/btn_request_grace_15m"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Request 15 Minute Grace Extension"
        android:textSize="15sp"
        android:backgroundTint="@color/teal_primary"
        android:textColor="@color/calm_surface"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Protected Allowlist (Never Locked):"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/soft_text"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• Phone &amp; Emergency Dialing
• Maps &amp; Navigation
• School Apps (Google Classroom, Canvas)
• Emergency Contacts"
        android:textSize="14sp"
        android:textColor="@color/soft_text"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
